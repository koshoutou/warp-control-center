# ====================================================================
# 后端服务环境变量示例
# 复制为 .env 并按需修改
# ====================================================================

# 代理监听端口（客户端指向此端口）
PROXY_PORT=40000

# 控制面端口（REST + WebSocket，内部端口）
CONTROL_PORT=3030

# warp-svc 上游地址（通常无需修改）
UPSTREAM_HOST=127.0.0.1
UPSTREAM_PORT=40001

# warp-svc / warp-cli 可执行文件路径
WARP_SVC_PATH=warp-svc
WARP_CLI_PATH=warp-cli

# WARP+ 许可证密钥（可选）
LICENSE=

# MDM 配置文件路径（Zero Trust 部署用）
MDM_FILE=/var/lib/cloudflare-warp/mdm.xml

# 启动时自动连接 WARP
AUTO_CONNECT=false

# 日志环形缓冲区大小
LOG_BUFFER_SIZE=500

# 指标采集间隔（毫秒）
METRICS_INTERVAL_MS=1000

# 强制演示模式（跳过 warp-svc 检测，用于无 root 环境）
FORCE_DEMO=false

# 最大并发连接数
MAX_CONNECTIONS=2048

# 连接空闲超时（毫秒）
IDLE_TIMEOUT_MS=120000
