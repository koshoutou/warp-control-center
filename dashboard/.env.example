# ====================================================================
# 前端面板环境变量示例
# 复制为 .env.local 并按需修改
# ====================================================================

# 部署模式选择（详见 docs/DEPLOYMENT.md#环境变量配置）：

# 模式 1（生产推荐）：同源模式
# 不设置下列变量，由 Nginx 反代统一路由 /api/* 到 :3030
NEXT_PUBLIC_WARP_API_BASE=

# 模式 2：网关查询模式（Caddy 网关环境）
# NEXT_PUBLIC_WARP_CONTROL_PORT=3030

# 模式 3：直连模式（本地开发）
# NEXT_PUBLIC_WARP_BASE_URL=http://127.0.0.1:3030

# 代理端口（仅用于面板展示）
NEXT_PUBLIC_WARP_PROXY_PORT=40000
