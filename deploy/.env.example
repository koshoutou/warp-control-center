# ====================================================================
# WARP 控制中心 —— 环境变量示例
# 复制为 .env 并按需修改：cp deploy/.env.example deploy/.env
# ====================================================================

# ---------- WARP 配置 ----------

# WARP+ 许可证密钥（可选，用于 WARP+ 流量额度）
# 从 1.1.1.1 客户端「账户」页面获取，格式类似：xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LICENSE=

# 启动时是否自动连接 WARP（true/false）
# Docker 部署推荐 true；裸机部署可设 false，通过面板手动连接
AUTO_CONNECT=true

# ---------- 代理配置 ----------

# 代理监听端口（客户端指向此端口）
PROXY_PORT=40000

# 最大并发连接数（DoS 防护）
MAX_CONNECTIONS=2048

# 连接空闲超时（毫秒，默认 120 秒）
IDLE_TIMEOUT_MS=120000

# ---------- 控制面配置（通常无需修改）----------

# 后端控制面端口（REST + WebSocket，内部端口）
CONTROL_PORT=3030

# warp-svc 上游地址（通常无需修改）
UPSTREAM_HOST=127.0.0.1
UPSTREAM_PORT=40001

# 指标采集间隔（毫秒）
METRICS_INTERVAL_MS=1000

# 日志环形缓冲区大小
LOG_BUFFER_SIZE=500

# ---------- 前端配置 ----------

# 部署模式（详见 docs/DEPLOYMENT.md#环境变量配置）：
#   同源模式（生产推荐）：不设置下列变量，由 Nginx 反代统一路由
#   网关查询模式（Caddy）：设置 NEXT_PUBLIC_WARP_CONTROL_PORT=3030
#   直连模式（开发）：设置 NEXT_PUBLIC_WARP_BASE_URL=http://127.0.0.1:3030

# NEXT_PUBLIC_WARP_CONTROL_PORT=3030
# NEXT_PUBLIC_WARP_BASE_URL=http://127.0.0.1:3030
NEXT_PUBLIC_WARP_PROXY_PORT=40000
