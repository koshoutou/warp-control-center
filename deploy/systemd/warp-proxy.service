# ====================================================================
# WARP 控制中心 —— 后端 systemd 服务
# 部署: sudo cp deploy/systemd/warp-proxy.service /etc/systemd/system/
# 启动: sudo systemctl enable --now warp-proxy
# ====================================================================
[Unit]
Description=WARP 控制中心 - 后端服务（代理 + 控制面）
Documentation=https://github.com/koshoutou/warp-control-center
After=network-online.target warp-svc.service
Wants=network-online.target
Requires=warp-svc.service

[Service]
Type=simple
User=root
Group=root

# 工作目录
WorkingDirectory=/opt/warp-control-center/mini-services/warp-proxy

# 环境变量（从 /etc/warp-control-center.env 加载）
EnvironmentFile=-/etc/warp-control-center.env

# 启动命令（用 bun 运行；若用 node 改为 node index.js）
ExecStart=/usr/local/bin/bun index.ts

# 自动重启
Restart=on-failure
RestartSec=5s

# 资源限制
LimitNOFILE=65536
MemoryMax=512M
CPUQuota=100%

# 日志
StandardOutput=journal
StandardError=journal
SyslogIdentifier=warp-proxy

[Install]
WantedBy=multi-user.target
